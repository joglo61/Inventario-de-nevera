SUPABASE_URL=
# Clave publicable (o "anon") del proyecto; la seguridad la dan las reglas RLS.
SUPABASE_PUBLISHABLE_KEY=
# Site key de Cloudflare Turnstile (CAPTCHA del inicio de sesión). La secret key va en Supabase, no aquí.
TURNSTILE_SITE_KEY=
# Avisos en el celular (recordatorio semanal). Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@gmail.com
# Mismo valor que el secreto 'recordatorio_cron' en Supabase Vault (lo usa pg_cron para llamar /api/recordatorio)
CRON_SECRET=
